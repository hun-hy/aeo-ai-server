const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    message: "AEO AI Server is running 🚀"
  });
});

app.get("/health", (req, res) => {
  res.json({
    status: "online"
  });
});

// AI endpoint
app.post("/api/chat", (req, res) => {
  const question = req.body.question;

  if (!question) {
    return res.status(400).json({
      error: "Please provide a question."
    });
  }

  res.json({
    answer: `AEO AI received your question: ${question}`
  });
});

app.listen(PORT, () => {
  console.log(`AEO AI Server running on port ${PORT}`);
});
